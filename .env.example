# Backend gateway configuration (copy to .env or export before running).

# Base URL of the iacore inference service (the app that owns the models).
# On a different machine, point this at that host, e.g. http://10.0.0.5:8001
IACORE_URL=http://localhost:8001

# Comma-separated origins allowed to call this gateway from the browser.
# The deploy is same-origin and needs nothing here. With the vite dev server, name it:
# CORS_ORIGINS=http://localhost:5173 — the session cookie is only allowed for origins named
# explicitly, never with "*".
CORS_ORIGINS=*

# Port this gateway listens on (passed to uvicorn yourself, see README).
BACKEND_PORT=8000

# Optional: path to a built frontend (dist/). When set, this app also SERVES that
# SPA so the app + /api + /ws share one origin (the single-origin HTTPS deploy).
# When unset, this app stays a pure gateway.
# FRONTEND_DIST=

# Accounts: where the database, the first-run setup code and the camera bridge's device key
# live. Outside the repo on purpose. Default ~/.pilot.
# PILOT_DATA_DIR=
# Full SQLAlchemy async URL; overrides the SQLite file in PILOT_DATA_DIR.
# DATABASE_URL=
# Force the session cookie's Secure flag (behind a TLS-terminating proxy, where this app sees
# plain http). Automatic when this app itself serves HTTPS.
# COOKIE_SECURE=1

# Satellite view on the site maps (Fleet): an ArcGIS Location Platform API key scoped to
# basemaps only — its free tier covers 2M tiles a month and allows commercial use. Or put the
# key in PILOT_DATA_DIR/esri-api-key. Without one, only the street map shows.
# ESRI_API_KEY=
